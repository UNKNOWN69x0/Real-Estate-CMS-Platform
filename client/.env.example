# ============================================================
# One Chembur client: environment variables
# ============================================================

# LOCAL DEV ONLY: where Vite's /api proxy sends requests (default http://localhost:5000).
# The browser itself always calls /api on its own origin, so there is no CORS in dev.
VITE_API_URL=http://localhost:5000

# VERCEL: do NOT set VITE_API_URL. The browser calls /api on your Vercel domain and
# client/vercel.json rewrites it to your Render API, which keeps the login cookie first-party.
# Only set it (to the Render URL) if you deploy WITHOUT that rewrite; then the API also needs
# COOKIE_SAMESITE=none and CLIENT_URL set to this site's origin.
