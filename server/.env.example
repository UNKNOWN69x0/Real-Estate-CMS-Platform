# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/one_chembur?retryWrites=true&w=majority

# --- Auth ---
# Use a long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed client origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# --- Cloudinary (image/PDF uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed script (npm run seed) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@onechembur.com
SEED_ADMIN_PASSWORD=
