# ============================================================
# One Chembur API: environment variables
# Copy to .env for local development. On Render, set these in the dashboard
# (render.yaml declares them; secrets are marked sync:false).
# ============================================================

# --- Server ---
NODE_ENV=development
# Render sets PORT itself; only set it locally if 5000 is taken
PORT=5000

# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/one_chembur?retryWrites=true&w=majority

# --- Auth ---
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Lax is correct when the client proxies /api on its own domain (Vercel rewrite).
# Use "none" only if browsers call the API's own domain directly (cross-site); needs HTTPS.
COOKIE_SAMESITE=lax

# --- CORS / proxy ---
# Comma-separated list of allowed client origins, no trailing slash. MUST be https:// in production.
# Production example: https://one-chembur.vercel.app,https://www.yourdomain.com
CLIENT_URL=http://localhost:5173
# Reverse proxies in front of the API. Production behind Vercel + Render = 2 (the default when
# NODE_ENV=production). Locally leave unset (0).
TRUST_PROXY=

# --- Cloudinary (image/PDF uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed scripts (run from your machine: npm run seed) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@onechembur.com
SEED_ADMIN_PASSWORD=

# --- Emergency admin password reset (npm run reset-admin) ---
# Do NOT leave this set. Pass it for the one command, e.g.:
#   ADMIN_NEW_PASSWORD='a-new-long-password' npm run reset-admin
# ADMIN_NEW_PASSWORD=
